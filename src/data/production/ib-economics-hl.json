ects of exchange-rate changes","Quota protection","GDP and GNI measures","Macroeconomic equilibrium","Income elasticity of demand (YED)","Price controls"],"secondaryTopicIds":["topic.normalized.global-economy","topic.normalized.microeconomics"],"secondaryTopics":["Global economy","Microeconomics"],"session":"May","skills":["skill.analysis_chain_of_reasoning","skill.data_interpretation","skill.diagram_construct","skill.diagram_label","skill.economic_terminology","skill.evaluation_tradeoffs","skill.explanation_causal_chain","skill.knowledge_definition","skill.quantitative_calculation"],"solutionStatus":"Official IB markscheme image with extracted accessible transcript","sourceId":"ib-economics-hl:2024-may-tz2-hlsl-p2-q02","sourceLevels":["HL","SL"],"sourceMarkSchemeUrl":"https://ibdocs.re/p/IB%20PAST%20PAPERS%20-%20YEAR/2024%20Examination%20Session/May%202024%20Examination%20Session/Individuals%20and%20societies/Economics_paper_2__TZ2_HLSL_markscheme.pdf","sourceQuestionUrl":"https://ibdocs.re/p/IB%20PAST%20PAPERS%20-%20YEAR/2024%20Examination%20Session/May%202024%20Examination%20Session/Individuals%20and%20societies/Economics_paper_2__TZ2_HLSL.pdf","sourceType":"actual_past_paper","sourceUrl":"https://ibdocs.re/p/IB%20PAST%20PAPERS%20-%20YEAR/2024%20Examination%20Session/May%202024%20Examination%20Session/Individuals%20and%20societies/Economics_paper_2__TZ2_HLSL.pdf","subject":"Economics","subpartEvidence":[{"detailed_subtopic_ids":["content.global-economy.economic-barriers"],"part_id":"(a)(i)"},{"detailed_subtopic_ids":["content.macroeconomics.gdp-and-gni-measures"],"part_id":"(b)(i)"},{"detailed_subtopic_ids":["content.microeconomics.income-elasticity-of-demand-yed"],"part_id":"(b)(ii)"},{"detailed_subtopic_ids":["content.macroeconomics.macroeconomic-equilibrium"],"part_id":"(c)"},{"detailed_subtopic_ids":["content.global-economy.quota-protection"],"part_id":"(d)"},{"detailed_subtopic_ids":["content.global-economy.effects-of-exchange-rate-changes"],"part_id":"(e)"}