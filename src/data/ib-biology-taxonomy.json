{
  "ambiguity_rules": [
    {
      "case": "molecules_or_cells",
      "rule": "Use Molecules and cells when biochemical structure, cells, organelles, membranes, metabolism or energy conversion earns the marks; do not use a broad molecules label for an organism-level mechanism."
    },
    {
      "case": "gene_expression_or_inheritance",
      "rule": "Use Information, inheritance and evolution for DNA, genes, chromosomes, gene expression, cell division, inheritance, evolution or classification; use Molecules and cells only when the assessed mechanism is biochemical rather than genetic information."
    },
    {
      "case": "transport_context",
      "rule": "Use Organisms and body systems for blood, gas, water, digestion or transport physiology; use Molecules and cells for membrane transport or concentration-driven cellular processes."
    },
    {
      "case": "signalling_or_homeostasis",
      "rule": "Use Organisms and body systems for neural, hormonal, homeostatic and integrated body-system responses; keep receptor or membrane-potential mechanisms there when they are the assessed biology."
    },
    {
      "case": "ecology_or_evolution",
      "rule": "Use Populations, ecosystems and environmental change for population, community, niche, energy-flow, cycling or climate mechanisms; use Information, inheritance and evolution for selection, speciation, diversity and classification."
    },
    {
      "case": "data_or_practical_work",
      "rule": "Data handling, statistics, microscopy, experimental design and evaluation are skills and AO controls; they do not replace a content topic or official code."
    },
    {
      "case": "old_options",
      "rule": "Old option codes remain internal legacy identifiers. Never convert an old option into a 2025 topic code merely because the normalized area is similar."
    },
    {
      "case": "mixed_question",
      "rule": "Split at independent subquestion or mark-cluster level. If a single mark cluster genuinely assesses inseparable concepts, use controlled secondary subtopics and document evidence."
    }
  ],
  "assessment_objective_controls": {
    "AO1": "Demonstrate knowledge and understanding of biology, including facts, concepts and terminology.",
    "AO2": "Apply knowledge and understanding of biology to unfamiliar or real-world contexts.",
    "AO3": "Analyse, evaluate and synthesize biological information, evidence and data.",
    "AO4": "Demonstrate practical and investigative skills, including planning, processing and evaluating scientific work."
  },
  "assessment_objectives": [
    "AO1",
    "AO2",
    "AO3",
    "AO4"
  ],
  "classification_rules": [
    "Preserve the exact official code and curriculum era separately from normalized labels.",
    "Use only codes in the official structure for the question's era; never use a cross-era code as a substitute or student-facing legacy label.",
    "Assign exactly one primary normalized topic and one primary normalized subtopic.",
    "Use secondary subtopics only for independently assessed concepts that are genuinely inseparable and never duplicate the primary.",
    "Split at subquestion or independent mark-cluster level when different concepts earn separate marks.",
    "Treat practical work, data-based format, statistics, technology and inquiry as skills or assessment context, not automatic topic codes.",
    "Reject overbroad labels such as general biology, all topics, mixed biology or other; return needs_review rather than guessing.",
    "Every final classification must contain at least one exact code from the source question’s era; code-free exceptions are evidence-backed and currently none are approved.",
    "Classify by the biology knowledge or reasoning required to earn marks, not merely by the stem context."
  ],
