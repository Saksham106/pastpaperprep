  "classification_rules": [
    "Preserve the exact official code and curriculum era separately from normalized labels.",
    "Use only codes in the official structure for the question's era; never use a cross-era code as a student-facing legacy label.",
    "Classify by the physics knowledge or reasoning required to earn marks, not merely by the stem context.",
    "Assign exactly one primary normalized topic and one primary normalized subtopic.",
    "Use secondary subtopics only when independently assessed concepts are genuinely inseparable.",
    "Split at subquestion or independent mark-cluster level when different concepts earn separate marks.",
    "Treat Tools, Inquiry, mathematics, practical work and data-based format as skills or assessment context, not automatic official topic codes.",
    "Keep environmental, medical, industrial, engineering and astronomical settings as context unless their physics is what earns the marks.",
    "Return needs_review rather than guessing when source evidence does not support a controlled label."
  ],
  "ambiguity_rules": [
    {
      "case": "measurement_or_data_handling",
      "rule": "Use F only when measurement, uncertainty, graphing or data evaluation earns the marks; otherwise keep the assessed physics concept primary."
    },
    {
      "case": "gravity_and_fields",
      "rule": "Use M for Newtonian motion, circular motion or orbital mechanics; use R for relativity, stellar or cosmological reasoning; use E for electric or magnetic field reasoning."
    },
    {
      "case": "energy_context",
      "rule": "Use M for mechanical work and power, T for thermal transfer or energy systems, E for electrical power or circuits, and N/R for nuclear or stellar energy mechanisms."
    },
    {
      "case": "wave_or_imaging_context",
      "rule": "Use W for wave, optics, imaging, diffraction, interference or resonance physics; use N only when atomic spectra or matter-radiation interaction is the assessed mechanism."
    },
    {
      "case": "electromagnetic_fields",
      "rule": "Use E for electric or magnetic fields, forces, induction and circuits; use M only when the mark is specifically about the resulting mechanical motion."
    },
    {
      "case": "relativity",
      "rule": "Use R for Galilean or special relativity, spacetime, relativistic mechanics and general relativity; do not relabel old Option A codes as new A.5 codes."
    },
    {
      "case": "astrophysics_and_stars",
      "rule": "Use R for stellar quantities, stellar evolution, cosmology or stellar fusion; use N for nuclear reaction physics when the astronomical setting is incidental."
    },
    {
      "case": "removed_old_option_content",
      "rule": "Keep the old official option code internally and map only to a normalized topic. Do not force removed engineering, imaging, medical-imaging or further-cosmology material into current official codes."
    },
    {
      "case": "tools_and_inquiry",
      "rule": "Tools and Inquiry are controlled skills or assessment-process labels, never official topic codes and never substitutes for A.1-E.5."
    }
  ],
