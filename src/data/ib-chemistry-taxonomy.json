  "classification_rules": [
    "Preserve the exact official code and curriculum era separately from normalized labels.",
    "Classify by the knowledge or reasoning required to earn marks, not merely by the stem context.",
    "Assign exactly one primary normalized topic and one primary normalized subtopic.",
    "Use secondary topics only when independently assessed concepts are genuinely inseparable.",
    "Split at subquestion or independent mark-cluster level when different concepts earn separate marks.",
    "Treat Tools, Inquiry and data-based format as skills, not automatic content topics.",
    "Keep environmental, medical, industrial and biological settings as context tags, not top-level topics.",
    "Return needs_review rather than guessing when source evidence does not support a controlled label."
  ],
  "ambiguity_rules": [
    {"case": "fuel_cells", "rule": "E when fuel or energy conversion is assessed; R when electrode reactions, cell potential or electrochemistry is assessed."},
    {"case": "transition_metal_complexes", "rule": "A for transition-element behavior, B for bonding or geometry, R for oxidation-state or redox reasoning."},
    {"case": "spectroscopy", "rule": "O for molecular identification; D only for calibration, uncertainty, graphing or analytical measurement."},
    {"case": "titrations", "rule": "C or R by reaction family; M may be secondary when mole-ratio arithmetic is independently assessed."},
    {"case": "organic_mechanisms", "rule": "O primary, including material officially coded Reactivity 3.4."},
    {"case": "lewis_acids_and_coordination", "rule": "B when bonding or coordination is assessed; C when acid-base behavior is assessed."},
    {"case": "biochemistry", "rule": "O normally; C for amphoterism, buffers, pH or isoelectric-point reasoning."},
    {"case": "nuclear_energy_or_medicine", "rule": "A for nuclear structure, isotopes or radioactivity; E for energy production."},
    {"case": "data_based_questions", "rule": "Data-based is a format. Keep the assessed chemistry topic primary unless data handling itself earns the marks."}
