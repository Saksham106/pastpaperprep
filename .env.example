# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Object storage (defaults to Supabase when unset)
ASSET_STORAGE_PROVIDER=supabase
R2_ACCOUNT_ID=
R2_BUCKET_NAME=pastpaperprep-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Local migration only. Use a temporary Object Read & Write token; never add these to Vercel.
R2_SYNC_ACCESS_KEY_ID=
R2_SYNC_SECRET_ACCESS_KEY=

# Stripe
STRIPE_BILLING_ENABLED=false
STRIPE_LIVE_MODE_ENABLED=false
# Server-owned plan changes from the account page
STRIPE_PLAN_EDITOR_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_MONTHLY_PRICE_ID=
STRIPE_FOUNDING_ANNUAL_PRICE_ID=
STRIPE_SINGLE_MONTHLY_PRICE_ID=
STRIPE_SINGLE_ANNUAL_PRICE_ID=
STRIPE_PAIR_MONTHLY_PRICE_ID=
STRIPE_PAIR_ANNUAL_PRICE_ID=
STRIPE_CUSTOM_MONTHLY_PRICE_ID=
STRIPE_CUSTOM_ANNUAL_PRICE_ID=
STRIPE_ALL_MONTHLY_PRICE_ID=
STRIPE_ALL_ANNUAL_PRICE_ID=

# Application
NEXT_PUBLIC_SITE_URL=https://pastpaperprep.com
# Signs the referral cookie (any long random string)
REFERRAL_COOKIE_SECRET=
# Optional: emits the Search Console verification meta tag
GOOGLE_SITE_VERIFICATION=

# Release gates (each bank family needs both flags once its assets are verified)
PASTPAPERPREP_ENABLE_IGCSE_RELEASE_BANKS=false
PASTPAPERPREP_IGCSE_RELEASE_ASSETS_VERIFIED=false
PASTPAPERPREP_ENABLE_IB_ECONOMICS_PRODUCTION=false
PASTPAPERPREP_IB_ECONOMICS_ASSETS_VERIFIED=false
# Development only: serve IB Economics previews from a local source workspace
PASTPAPERPREP_ENABLE_LOCAL_IB_ECONOMICS_PREVIEW=false
PASTPAPERPREP_IB_ECONOMICS_SOURCE_ROOT=

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
# Server-side capture (falls back to the NEXT_PUBLIC_ values)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
# Build-time source-map upload; only used on Vercel Linux builds
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
