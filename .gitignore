# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# Persistent IndexNow URL baseline and delivery state are CI cache/artifacts only.
.indexnow/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/
*.py[cod]

# next.js
/.next/
# server-only asset manifests (npm run generate:asset-manifest)
/generated/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local git worktrees
.worktrees/

# supabase cli
supabase/.temp/

# generated bank metadata
/public/bank-index/

# Local-only paper design fixtures. Never commit original examination PDFs.
/private/paper-preview/
/private/chemistry-paper-archive/
/private/paper-archives/

# typescript
*.tsbuildinfo
next-env.d.ts
