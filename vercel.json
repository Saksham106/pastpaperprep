{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "feat/explanations-*": false,
      "dependabot/**": false
    }
  },
  "routes": [
    {
      "src": "/pp-relay/static/(.*)",
      "dest": "https://us-assets.i.posthog.com/static/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "cookie"
          }
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "referer"
          }
        }
      ]
    },
    {
      "src": "/pp-relay/array/(.*)",
      "dest": "https://us-assets.i.posthog.com/array/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "cookie"
          }
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "referer"
          }
        }
      ]
    },
    {
      "src": "/pp-relay/(.*)",
      "dest": "https://us.i.posthog.com/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "cookie"
          }
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "referer"
          }
        }
      ]
    }
  ],
  "schedules": {
    "access-end-reminders": {
      "schedule": "17 9,15 * * *",
      "path": "/api/cron/access-end-reminders",
      "requestMethod": "GET"
    }
  }
}
