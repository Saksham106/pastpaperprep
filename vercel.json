{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "feat/explanations-*": false,
      "dependabot/**": false
    }
  },
  "routes": [
    {
      "src": "/__ingest-check/(.*)",
      "dest": "https://httpbin.org/anything/$1",
      "transforms": [{ "type": "request.headers", "op": "delete", "target": { "key": "cookie" } }]
    },
    {
      "src": "/ingest/static/(.*)",
      "dest": "https://us-assets.i.posthog.com/static/$1",
      "transforms": [{ "type": "request.headers", "op": "delete", "target": { "key": "cookie" } }]
    },
    {
      "src": "/ingest/array/(.*)",
      "dest": "https://us-assets.i.posthog.com/array/$1",
      "transforms": [{ "type": "request.headers", "op": "delete", "target": { "key": "cookie" } }]
    },
    {
      "src": "/ingest/(.*)",
      "dest": "https://us.i.posthog.com/$1",
      "transforms": [{ "type": "request.headers", "op": "delete", "target": { "key": "cookie" } }]
    }
  ]
}
